<camera
  class="camera"
  device-position="{{position}}"
  flash="{{flash}}"
  bindinitdone="onEvent"
  bindstop="onEvent"
  binderror="onEvent"
></camera>
<view class="card">
  <view class="btns">
    <button size="mini" type="primary" bindtap="takePhoto">takePhoto</button>
    <button size="mini" bindtap="startRecord" disabled="{{recording}}">startRecord</button>
    <button size="mini" bindtap="stopRecord" disabled="{{!recording}}">stopRecord</button>
    <button size="mini" bindtap="switchPosition">device-position: {{position}}</button>
    <button size="mini" bindtap="cycleFlash">flash: {{flash}}</button>
  </view>
</view>
<view class="card" wx:if="{{photo}}">
  <text class="title">照片</text>
  <image class="result" src="{{photo}}" mode="aspectFit" bindload="onEvent" binderror="onEvent" />
</view>
<view class="card" wx:if="{{video}}">
  <text class="title">录像</text>
  <image class="result" src="{{thumb}}" mode="aspectFit" />
  <video class="result" src="{{video}}" binderror="onEvent"></video>
</view>
<log-panel logs="{{logs}}" bind:clear="clearLog" />
