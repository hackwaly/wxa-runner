page { background: #f5f5f5; font-size: 28rpx; color: #333; }
.card { margin: 24rpx; padding: 24rpx; background: #fff; border-radius: 12rpx; }
.title { font-size: 32rpx; font-weight: bold; margin-bottom: 16rpx; display: block; }

/* 「能力」里的演示页共用 */
.hint { display: block; color: #999; font-size: 24rpx; margin-bottom: 16rpx; }
.btns { display: flex; flex-wrap: wrap; }
.btns button { margin: 0 16rpx 16rpx 0; }
.field { padding: 8rpx 0; color: #666; word-break: break-all; }
