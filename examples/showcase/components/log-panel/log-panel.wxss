.placeholder { height: calc(360rpx + env(safe-area-inset-bottom)); }
.panel {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 100;
  height: 360rpx; padding-bottom: env(safe-area-inset-bottom);
  background: #1e1e1e; color: #d4d4d4;
  font-family: Menlo, Consolas, monospace; font-size: 22rpx;
}
.head {
  display: flex; justify-content: space-between; align-items: center;
  height: 56rpx; padding: 0 20rpx; background: #2d2d2d; color: #999;
}
.clear { color: #4fc3f7; padding: 8rpx 0 8rpx 24rpx; }
.lines { height: 304rpx; }
.line, .empty { padding: 4rpx 20rpx; word-break: break-all; border-bottom: 1px solid #2a2a2a; }
.empty { color: #666; }
